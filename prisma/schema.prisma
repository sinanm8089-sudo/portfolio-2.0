generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String         @default("Sinan Mohammed")
  role         String         @default("ADMIN")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  activityLogs ActivityLog[]

  @@index([email])
}

model AdminSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model SiteSettings {
  id                 String   @id @default("default")
  siteName           String   @default("Sinan Mohammed | Cybersecurity & AI Portfolio")
  heroBadge          String   @default("[ SYS.STATUS: ONLINE ]")
  heroGreeting       String   @default("> initializing sequence...")
  heroName           String   @default("Sinan Mohammed")
  heroTitles         String[] @default(["Cybersecurity Student", "AI Enthusiast", "Full-Stack Developer", "Penetration Tester"])
  heroBio            String   @default("I’m Sinan Mohammed, a Cyber Security student and developer focused on ethical hacking, penetration testing, AI-driven security, and building practical digital solutions. Based in Kerala, India, I turn curiosity into hands-on security projects and continuous technical growth.")
  profileImage       String?
  cvUrl              String?  @default("/certificates/CERT_SINAN_MOHAMMED_1760514672459.pdf")
  primaryCtaLabel    String   @default("> ./connect.sh")
  primaryCtaUrl      String   @default("#contact")
  secondaryCtaLabel  String   @default("> ./projects.sh")
  secondaryCtaUrl    String   @default("#projects")
  glitchIntensity    String   @default("MEDIUM")
  showStats          Boolean  @default(true)
  aboutHeading       String   @default("> Authentication successful.")
  aboutBio           String   @default("My name is Sinan Mohammed, and I am a B.Tech Cyber Security student under APJ Abdul Kalam Technological University (KTU) from Kerala, India. I am passionate about cyber security engineering, ethical hacking, penetration testing, AI security, and secure software development.")
  careerObjective    String   @default("To grow into a strong cyber security and AI engineering professional by building deep technical skills in penetration testing, network security, intelligent threat detection, secure development, and system hardening.")
  location           String   @default("Malappuram, Kerala, India")
  contactEmail       String   @default("sinan.m8089@gmail.com")
  emailNotifications Boolean  @default(true)
  notifyEmail        String   @default("sinan.m8089@gmail.com")
  clarityProjectId   String?
  maintenanceMode    Boolean  @default(false)
  disableAnimations  Boolean  @default(false)
  footerText         String   @default("© 2024 Sinan Mohammed. SYSTEM.HALTED")
  updatedAt          DateTime @updatedAt
}

model Page {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  isPublished Boolean   @default(true)
  sections    Section[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Section {
  id         String           @id @default(uuid())
  pageId     String
  page       Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key        String
  title      String
  subtitle   String?
  order      Int              @default(0)
  isVisible  Boolean          @default(true)
  status     PublishStatus    @default(PUBLISHED)
  configJson Json?
  elements   ContentElement[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([pageId, key])
  @@index([pageId, order])
}

model ContentElement {
  id          String   @id @default(uuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  elementType String
  label       String
  content     String?
  imageUrl    String?
  linkUrl     String?
  styleJson   Json?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([sectionId, order])
}

model ThemeSettings {
  id              String   @id @default("default")
  name            String   @default("Cybersecurity Command Center")
  isActive        Boolean  @default(true)
  primaryColor    String   @default("#39FF88")
  secondaryColor  String   @default("#00D9FF")
  bgPrimary       String   @default("#050807")
  bgSurface       String   @default("#0B1210")
  textPrimary     String   @default("#F3F7F5")
  textMuted       String   @default("#87938D")
  fontSans        String   @default("Inter")
  fontMono        String   @default("Fira Code")
  borderRadius    String   @default("0.5rem")
  enableScanlines Boolean  @default(true)
  enableGlitch    Boolean  @default(true)
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model SceneSettings {
  id              String   @id @default("default")
  sceneKey        String   @unique @default("hero_globe")
  isEnabled       Boolean  @default(true)
  preset          String   @default("CYBER_MATRIX")
  primaryColor    String   @default("#39FF88")
  secondaryColor  String   @default("#FF003C")
  particleDensity Int      @default(1500)
  animationSpeed  Float    @default(1.0)
  rotationSpeed   Float    @default(0.5)
  desktopQuality  String   @default("HIGH")
  mobileQuality   String   @default("MEDIUM")
  reducedMotion   Boolean  @default(false)
  configJson      Json?
  updatedAt       DateTime @updatedAt
}

model Project {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  summary      String
  description  String
  architecture String?
  keyFeatures  String[]       @default([])
  thumbnailUrl String?
  githubUrl    String?
  liveUrl      String?
  techStack    String[]       @default([])
  category     String         @default("Cybersecurity")
  devStatus    String         @default("Completed")
  isFeatured   Boolean        @default(false)
  status       PublishStatus  @default(PUBLISHED)
  displayOrder Int            @default(0)
  projectDate  DateTime       @default(now())
  images       ProjectImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, displayOrder])
  @@index([category])
}

model ProjectImage {
  id           String  @id @default(uuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  caption      String?
  displayOrder Int     @default(0)

  @@index([projectId])
}

model SkillCategory {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  icon           String  @default("Terminal")
  terminalHeader String  @default("bin/skills.sh")
  displayOrder   Int     @default(0)
  isVisible      Boolean @default(true)
  skills         Skill[]

  @@index([displayOrder])
}

model Skill {
  id           String        @id @default(uuid())
  name         String
  commandLabel String?
  categoryId   String
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  icon         String?
  proficiency  Int           @default(80)
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, displayOrder])
  @@index([status, isVisible])
}

model Experience {
  id           String        @id @default(uuid())
  title        String
  organization String
  location     String?
  type         String        @default("Experience")
  startDate    String
  endDate      String?
  isCurrent    Boolean       @default(false)
  description  String
  highlights   String[]      @default([])
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

model Education {
  id           String        @id @default(uuid())
  degree       String
  institution  String
  university   String?
  location     String?
  startYear    String
  endYear      String?
  isCurrent    Boolean       @default(true)
  description  String?
  grade        String?
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

model Certification {
  id           String        @id @default(uuid())
  title        String
  organization String
  issueDate    String
  credentialId String?
  verifyUrl    String?
  fileUrl      String?
  description  String?
  icon         String        @default("Award")
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

model SocialLink {
  id           String  @id @default(uuid())
  platform     String
  label        String
  url          String
  icon         String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  @@index([displayOrder])
}

model LinkedInPost {
  id           String        @id @default(uuid())
  title        String
  description  String
  postUrl      String
  imageUrl     String?
  postDate     String
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
}

model ContactMessage {
  id          String         @id @default(uuid())
  senderName  String
  senderEmail String
  subject     String         @default("Portfolio Inquiry")
  category    String         @default("General")
  message     String
  status      MessageStatus  @default(NEW)
  isSpam      Boolean        @default(false)
  ipHash      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  replies     ContactReply[]

  @@index([status, createdAt])
  @@index([senderEmail])
}

model ContactReply {
  id              String         @id @default(uuid())
  messageId       String
  contactMessage  ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  adminEmail      String
  subject         String
  body            String
  resendMessageId String?
  sentAt          DateTime       @default(now())

  @@index([messageId])
}

model MediaAsset {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  sizeBytes Int      @default(0)
  folder    String   @default("general")
  altText   String?
  createdAt DateTime @default(now())

  @@index([folder])
}

model NavigationItem {
  id           String  @id @default(uuid())
  label        String
  href         String
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
  isExternal   Boolean @default(false)

  @@index([displayOrder])
}

model SeoMetadata {
  id              String   @id @default(uuid())
  pageSlug        String   @unique
  metaTitle       String
  metaDescription String
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  canonicalUrl    String?
  keywords        String[] @default([])
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id           String   @id @default(uuid())
  eventType    String
  path         String   @default("/")
  targetId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([eventType, createdAt])
}

model ActivityLog {
  id         String     @id @default(uuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}
